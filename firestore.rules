rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Team members & engineer profiles
    match /team/{memberId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.addedByUid == request.auth.uid;
      allow update, delete: if isAuthenticated();
    }

    // Recruitment Applications
    // Anyone can apply (submit); only authenticated team members can view or manage submissions.
    match /applications/{applicationId} {
      allow create: if true 
        // Validate required fields exist and type/length to prevent spam
        && request.resource.data.keys().hasAll(['name', 'email', 'branch', 'roll', 'vertical', 'why', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() < 100
        && request.resource.data.why is string && request.resource.data.why.size() <= 3000;
      allow read, update, delete: if isAuthenticated();
    }

    // Blog / Build Log Posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAuthenticated();
    }

    // Team Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAuthenticated();
    }

    // Roadmap Status Progress
    match /roadmap/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Engineer Technical Logs (Profile Portfolio)
    match /engineer_logs/{logId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAuthenticated();
    }

    // Media & Workshop Gallery
    match /gallery/{mediaId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAuthenticated();
    }

    // In-App Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      // Notifications are managed server-side (if at all); clients only track read status locally in localStorage
      allow write: if false; 
    }
  }
}
